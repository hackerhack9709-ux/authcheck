# PayCheck server environment.
# Copy to .env, fill in, and NEVER commit the filled file.

# --- Razorpay (from dashboard.razorpay.com → Settings → API Keys) ---
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Proxy gate ---
# The browser sends these as HTTP Basic credentials. They are NOT your
# Razorpay keys — they only stop strangers from using your proxy to look up
# arbitrary payments. Pick a long random password.
PROXY_USER=merchant
PROXY_PASS=change-me-to-something-long

# --- Server ---
# Most hosts inject PORT themselves; leave it out unless running locally.
# PORT=8080

# Point at a stub only when testing; leave unset for real Razorpay.
# RAZORPAY_API_BASE=https://api.razorpay.com
